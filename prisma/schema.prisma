// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InventoryItem {
  id            Int      @id @default(autoincrement())
  sessionId     String
  itemId        Int
  itemName      String
  imageSrc      String
  purchasePrice Int
  sellPrice     Int
  quantity      Int
  createdAt     DateTime @default(now())

  @@unique([sessionId, itemId])
}

model Transaction {
  id            Int      @id @default(autoincrement())
  sessionId     String
  itemId        Int
  itemName      String
  imageSrc      String?
  quantity      Int
  pricePaid     Int
  type          String   @default("PURCHASE")
  orderId       String?
  purchasedAt   DateTime @default(now())
}

model Balance {
  sessionId String @id
  money     Int    @default(5000)
}

model Sale {
  id              Int      @id @default(autoincrement())
  word            String
  discountPercent Int
  expiresAt       DateTime
}

model SaleItemUsage {
  id            Int @id @default(autoincrement())
  saleId        Int
  itemId        Int
  usesRemaining Int

  @@unique([saleId, itemId])
}

model ShopCatalog {
  id    Int  @id
  items Json
}